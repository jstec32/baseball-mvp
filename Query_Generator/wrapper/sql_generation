Q: Show me Luis Castillo’s monthly ERA during the 2025 season.
A:
SELECT
  DATE_TRUNC('month', pgl.game_date)                                             AS month,
  (SUM(pgl.earned_runs) * 9.0)
    / (SUM(pgl.outs_pitched)::FLOAT / 3.0)                                        AS era
FROM pitcher_game_logs AS pgl
JOIN players                 AS pl
  ON CONCAT(pl."First_Name", ' ', pl."Last_Name") = 'Luis Castillo'
WHERE pgl.pitcher_id = pl.key_mlbam::INT
  AND EXTRACT(year FROM pgl.game_date) = 2025
GROUP BY month
ORDER BY month

Q: What was Tarik Skubal’s K/9 by month in 2025?
A:
SELECT
  DATE_TRUNC('month', pgl.game_date)                                             AS month,
  (SUM(pgl.strikeouts) * 9.0)
    / (SUM(pgl.outs_pitched)::FLOAT / 3.0)                                        AS k_per_9
FROM pitcher_game_logs AS pgl
JOIN players                     AS pl
  ON CONCAT(pl."First_Name", ' ', pl."Last_Name") = 'Tarik Skubal'
WHERE pgl.pitcher_id = pl.key_mlbam::INT
  AND EXTRACT(year FROM pgl.game_date) = 2025
GROUP BY month
ORDER BY month

Q: Show me the total earned runs and innings pitched in May 2025.
A:
SELECT
  SUM(pgl.earned_runs)                    AS total_earned_runs,
  SUM(pgl.outs_pitched)::FLOAT / 3.0       AS total_innings_pitched
FROM pitcher_game_logs AS pgl
WHERE EXTRACT(year  FROM pgl.game_date) = 2025
  AND EXTRACT(month FROM pgl.game_date) = 5

Q: List the top 5 hitters by wrc_plus in the 2025 season so far.
A:
SELECT
  hs.key_mlbam,
  hs.name,
  hs.wrc_plus
FROM hitter_season_statistics AS hs
WHERE hs.season = 2025
  AND hs.plate_appearances >= (
    SELECT MAX(hs2.games) * 3.1
    FROM hitter_season_statistics AS hs2
    WHERE hs2.season = 2025
  )
ORDER BY hs.wrc_plus DESC
LIMIT 5

Q: What is Mookie Bett’s on_base_percentage in 2025?
A:
SELECT
  hs.on_base_percentage
FROM hitter_season_statistics AS hs
JOIN players               AS pl
  ON CONCAT(pl."First_Name", ' ', pl."Last_Name") = 'Mookie Betts'
WHERE hs.key_mlbam = pl.key_mlbam
  AND hs.season    = 2025

